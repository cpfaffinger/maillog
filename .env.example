# Copy to .env and adjust (chmod 600 .env).

# Database password (required). Generate e.g. with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Initial password of the default user "admin" (only used on the very first start).
# If empty, a random password is generated and written once to the container log.
MAILLOG_ADMIN_PASSWORD=change-me-to-a-long-random-string

# Public base URL. Required for passkeys (WebAuthn relying party) and used in install commands and alerts.
MAILLOG_PUBLIC_URL=https://maillog.example.com

# Host port published on 127.0.0.1 (put your reverse proxy in front).
MAILLOG_PORT=33023

TZ=Europe/Vienna

# Initial retention of mail events in days (default 180). Can be changed later in the UI.
MAILLOG_RETENTION_DAYS=180

# --- Alert channels (any combination; none = alerts are only visible in the UI) ---
# Generic webhook. Format: json | slack | discord | ntfy
MAILLOG_WEBHOOK_URL=
MAILLOG_WEBHOOK_FORMAT=json

# signal-cli-rest-api (https://github.com/bbernhard/signal-cli-rest-api)
MAILLOG_SIGNAL_URL=
MAILLOG_SIGNAL_NUMBER=
MAILLOG_SIGNAL_RECIPIENTS=

# SMTP. Ideally NOT through the mail system you are monitoring.
MAILLOG_SMTP_HOST=
MAILLOG_SMTP_PORT=587
MAILLOG_SMTP_USER=
MAILLOG_SMTP_PASSWORD=
MAILLOG_SMTP_STARTTLS=true
MAILLOG_SMTP_FROM=
MAILLOG_SMTP_TO=

# --- Alert tuning ---
MAILLOG_OFFLINE_AFTER_S=180
MAILLOG_SENT_THRESHOLD=5000
# Comma separated sender domains that may appear without a DKIM signing key.
MAILLOG_ALLOWED_FOREIGN_DOMAINS=
MAILLOG_RENOTIFY_S=21600
MAILLOG_ENROLL_TTL_HOURS=24
