# Copy to .env and adjust (chmod 600 .env).

# Database password (required). Generate e.g. with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# There is no admin password here: users live in the database. On the very first start the user "admin" is created
# with a random password that is logged ONCE and written to ./data/app/initial-admin-password.txt on the Docker host.

# Public base URL. Required for passkeys (WebAuthn relying party) and used in install commands and alerts.
MAILLOG_PUBLIC_URL=https://maillog.example.com

# Host port published on 127.0.0.1 (put your reverse proxy in front).
MAILLOG_PORT=33023

TZ=Europe/Vienna

# Initial retention of mail events in days (default 180). Can be changed later in the UI.
MAILLOG_RETENTION_DAYS=180

# --- Alert channels ---
# Configured in the web UI (Settings -> Alert channels): SMTP (own server, with or without authentication), Signal, webhook.
# They are stored in the database; the SMTP password is encrypted there. Use an SMTP server that does NOT depend on the mail system you monitor.

# --- Alert tuning ---
MAILLOG_OFFLINE_AFTER_S=180
MAILLOG_SENT_THRESHOLD=5000
# Comma separated sender domains that may appear without a DKIM signing key.
MAILLOG_ALLOWED_FOREIGN_DOMAINS=
MAILLOG_RENOTIFY_S=21600
MAILLOG_ENROLL_TTL_HOURS=24
